# Application
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=

# JWT
JWT_ACCESS_SECRET=replace_with_a_secure_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_secure_refresh_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_DOMAIN=localhost

# Email
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@localhost.localdomain

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=skillswap-local
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=replace_with_storage_access_key
STORAGE_SECRET_KEY=replace_with_storage_secret_key

# Logging
LOG_LEVEL=info
